{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "astra-demo-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=8080",
        "--web-hostname=127.0.0.1",
        "--dart-define=ASTRA_DEMO=true"
      ],
      "port": 8080
    },
    {
      "name": "astra-web-live",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=8081",
        "--web-hostname=127.0.0.1"
      ],
      "port": 8081
    }
  ]
}
