rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user owns their profile and their library.
    //
    // Note that rules do not cascade: a `match` on a document says nothing
    // about its subcollections, so every subcollection below is listed
    // deliberately and anything not listed is denied. That is what keeps
    // `private/` — the usage counter and the rate-limit buckets — out of
    // reach of the client, while the Admin SDK inside the Cloud Functions
    // bypasses these rules entirely and can still write it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // The library. Writable because the app mirrors its own stories here
      // and deletes the ones the user deletes — which is exactly why the
      // free-story quota is counted from `private/usage` and not from these
      // documents. Deleting a story gives back shelf space, not allowance.
      match /stories/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Server-owned. Usage counters, rate-limit windows and the subscription
      // entitlement live here.
      //
      // Readable by the owner, because the app has to draw its own allowance
      // ring and know whether it is on Plus. Writable by nobody: these are
      // written by the Cloud Functions through the Admin SDK, which bypasses
      // rules entirely. A counter the client can edit is not a counter, and an
      // entitlement the client can set is a free subscription for anyone who
      // opens a Firestore console.
      match /private/{document=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // App-curated content (daily affirmations etc.) — read-only for signed-in users.
    match /affirmations/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Anything not named above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
