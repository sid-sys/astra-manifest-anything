# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kotlin compile-daemon scratch, written during Gradle builds
/android/.kotlin/

# Secrets. API keys live in Google Secret Manager, never in the repo and never
# in the app bundle — anything shipped in an APK can be extracted from it.
.env
.env.*
!.env.example

# Release signing. key.properties holds the keystore passwords and the .jks is
# the app's identity on Play — neither belongs in version control, and a repo
# that has ever contained them needs a new key, not a new commit.
android/key.properties
*.jks
*.keystore

# Old copies of Firebase config, kept by hand when a key is rotated. The live
# one is android/app/google-services.json; a stale one in history is just a
# second place a dead key can be found.
*.bak

# Claude Code scratch. launch.json (the demo web run config) is worth sharing;
# the scheduler lock is per-machine state.
.claude/scheduled_tasks.lock

# Play upload artefacts: large, regenerated by the build, and kept on disk only.
store/play/*.aab
store/play/*.apk
store/play/mapping-*.txt
.firebase/

# iOS signing and Firebase files: never commit (the repository is public)
ios/Runner/GoogleService-Info.plist
*.p12
*.mobileprovision
*.p8

# Everything in signing/ is private: Apple keys, certificates, profiles.
signing/
